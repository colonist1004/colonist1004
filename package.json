{
  "name": "photo-editor",
  "version": "2.0.0",
  "private": true,
  "description": "사진 편집기 (라이트룸 스타일) - Android APK",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "sync": "npm run prepare:web && cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "serve": "npm run prepare:web && npx --yes http-server www -p 8080 -c-1"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@mediapipe/tasks-vision": "^0.10.21"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3"
  }
}
